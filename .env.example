# Copy to .env (git-ignored) and fill in at least one provider. Load it with:
#   set -a; source .env; set +a
# See README.md, "Model providers", for every option.

# Where the SQLite database lives (created on first run).
KENJITSU_DATA=./data

# Provider chain. "auto" uses every configured provider below, in README order.
KENJITSU_PROVIDERS=auto

# --- API keys (any one is enough) ---
# KENJITSU_ANTHROPIC_API_KEY=sk-ant-...
# KENJITSU_ANTHROPIC_MODEL=claude-opus-5-5
# KENJITSU_OPENROUTER_API_KEY=sk-or-...
# KENJITSU_OPENROUTER_MODEL=anthropic/claude-sonnet-5.5
# KENJITSU_OPENAI_API_KEY=sk-...
# KENJITSU_OPENAI_MODEL=
# KENJITSU_OPENAI_BASE_URL=https://api.openai.com/v1

# --- CLI subscriptions: no key needed, just be logged in ---
#   claude auth login   (Claude Code)    codex login   (Codex CLI)
# KENJITSU_CLAUDE_CLI_MODEL=sonnet
# KENJITSU_CODEX_MODEL=
